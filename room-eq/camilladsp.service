# CamillaDSP as a user service: applies ~/camilladsp/configs/room-eq.yml to
# whatever camilladsp-link.service connects it to.
[Unit]
Description=CamillaDSP (room EQ)
After=pipewire.service wireplumber.service
PartOf=pipewire.service

[Service]
ExecStart=%h/camilladsp/camilladsp -a 127.0.0.1 -p 1234 -s %h/camilladsp/statefile.yml %h/camilladsp/configs/room-eq.yml
Restart=always
RestartSec=3
# It can hang instead of exiting when a thread crashes; do not wait long for it.
TimeoutStopSec=3

[Install]
WantedBy=pipewire.service
